programa {
    funcao inicio() {
        real nota1, nota2, media, soma

        escreva("Professor, digite a primeira nota do aluno: ")
        leia(nota1)

        escreva("professor, digite a segunda nota do aluno: ")
        leia(nota2)

        soma = nota1 + nota2 
        media = soma / 2

        escreva("A media do aluno nesse bimestre é de: ", media)
        

    }
}