programa {
    funcao inicio() {
        inteiro pontos_vitorias, vitorias, pontos_totais
        
            pontos_vitorias = 3
            vitorias = 5

                escreva("O CSA Ganhou 5 jogos de 7 partidas nesse Alagoano.","\n")
            

                pontos_totais = vitorias * pontos_vitorias

                escreva("O maior de Alagoas (CSA) Ganhou: ",pontos_totais,"pontos","\n")
    }
}