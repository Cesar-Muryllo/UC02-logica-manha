programa {
    funcao inicio() {
        inteiro quantidade_de_picole, comissao
        real valor_do_picole
        
        valor_do_picole = 2.00

            escreva("quantos picolés você vendeu hoje: ")
                leia(quantidade_de_picole)

        comissao = quantidade_de_picole * valor_do_picole

            escreva("Você teve a comissao de:", comissao,"R$")

    }
}