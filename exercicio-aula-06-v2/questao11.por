programa {
    funcao inicio() {
        real ingresso, meia_entrada, valor_total, deve_pagar
        inteiro estudantes

        ingresso = 50
        meia_entrada = 2
                
                escreva("Vocês querem quantos ingressos para assistir ao filme?: ")
                leia(estudantes)

        valor_total = ingresso * estudantes
        deve_pagar = valor_total / meia_entrada

                escreva(" processando.","\n")
                escreva("processando..","\n")
                escreva("processando...","\n")
                escreva("da um valor total de: R$", deve_pagar,"\n")
            


    }
}