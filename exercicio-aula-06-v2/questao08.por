programa {
    funcao inicio() {
        real distancia_ida, distancia_total
            
            escreva("Digite a distância da caminhada de ida: ")  
            leia(distancia_ida)
            

                    distancia_total = distancia_ida * 2

            escreva("======Resultado=====")
            escreva("A distância total percorrida no treino foi: ", distancia_total, " metros.\n") 


    }
}   