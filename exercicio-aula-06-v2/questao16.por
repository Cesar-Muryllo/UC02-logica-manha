programa {
    funcao inicio() {
        real valor_semanal, economizado
        
            escreva("Digite o quanto você economizou essas ultimas 4 semanas (R$):")
                leia(economizado)

        valor_semanal = economizado * 4

            escreva("Você economizou um valor total de:", valor_semanal,"R$")
    }
}